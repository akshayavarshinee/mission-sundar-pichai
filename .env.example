# ──────────────────────────────────────────────────────────────────────────
# ClearPort — environment template.  Copy to `.env` and fill in.
# NEVER commit a real .env.  In cloud, these come from Google Secret Manager.
# ──────────────────────────────────────────────────────────────────────────

# ── Runtime mode ──────────────────────────────────────────────────────────
# local  = docker-compose Phoenix + Postgres, Gemini via API key
# cloud  = Phoenix Cloud + Cloud SQL + Vertex AI
CLEARPORT_ENV=local

# ── Google / Gemini (runtime brain — required by hackathon) ───────────────
# Either a Gemini API key (AI Studio) for local dev...
GOOGLE_API_KEY=
# ...or Vertex AI (cloud). When using Vertex, set these instead:
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Models
CLEARPORT_GEMINI_MODEL=gemini-3-pro
CLEARPORT_JUDGE_MODEL=gemini-3-pro
CLEARPORT_EMBED_MODEL=gemini-embedding-001

# ── Arize Phoenix (the partner / trust layer) ─────────────────────────────
# local  -> http://localhost:6006  (docker-compose service)
# cloud  -> https://app.phoenix.arize.com
PHOENIX_HOST=http://localhost:6006
PHOENIX_API_KEY=
PHOENIX_PROJECT=clearport
# Collector endpoint for OTel span export (derived from host if blank)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# ── EasyPost (live carrier customs validation — TEST MODE ONLY) ───────────
# Use the TEST key (begins with EZTK...). Never a production key.
EASYPOST_API_KEY=
EASYPOST_MODE=test

# ── Postgres + pgvector (memory tiers ① law / ③ lessons + app state) ──────
# local docker-compose defaults below.
DATABASE_URL=postgresql+psycopg://clearport:clearport@localhost:5432/clearport

# ── Risk / tier configuration ─────────────────────────────────────────────
CLEARPORT_HARD_LINE_USD=2500
CLEARPORT_RISK_THRESHOLD=0.55

# ── Learning / promotion ──────────────────────────────────────────────────
CLEARPORT_PROMOTION_MIN_EVIDENCE=3
CLEARPORT_PROMOTION_MARGIN=0.10

# ── Drift detection ───────────────────────────────────────────────────────
CLEARPORT_DRIFT_WINDOW=10
CLEARPORT_DRIFT_PASSRATE_FLOOR=0.6
