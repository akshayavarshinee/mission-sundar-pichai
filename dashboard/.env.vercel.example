# ── Vercel split deployment (frontend on Vercel, backend stack on GCP VM) ──
#
# Copy these into Vercel → Project → Settings → Environment Variables.
# Apply to Production + Preview.

# Same-origin mode: leave empty so the browser calls your Vercel domain (/api/*).
# Vercel proxies to BACKEND_UPSTREAM server-side (avoids mixed-content blocks).
NEXT_PUBLIC_API_BASE=

# Server-side only — never exposed to the browser. Public URL of your GCP backend.
# Use HTTPS if you deployed Caddy (recommended): https://34-134-197-83.sslip.io
# Or raw HTTP during smoke tests: http://34.134.197.83:8080
BACKEND_UPSTREAM=https://YOUR-VM-SSLIP.sslip.io

# Phoenix UI deep links (runs on the VM, port 6006 — not proxied through Vercel).
NEXT_PUBLIC_PHOENIX_BASE=http://YOUR.VM.PUBLIC.IP:6006

# Optional: link to hosted Agent Builder console from the dashboard top bar.
NEXT_PUBLIC_AGENT_BUILDER_URL=https://console.cloud.google.com/gen-app-builder
